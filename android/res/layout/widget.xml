<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="@drawable/widget_bg"
    android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layoutDirection="rtl">
        <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#7D708A" android:textSize="13sp" android:textDirection="rtl" android:gravity="start" android:singleLine="true" android:text="☀️ הצעד של היום" />
        <TextView android:id="@+id/w_progress" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FF7F50" android:textSize="13sp" android:textStyle="bold" android:text="🌱 צעד קטן" />
    </LinearLayout>
    <TextView android:id="@+id/w_text" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:textColor="#3B2F4A" android:textSize="17sp" android:textStyle="bold" android:textDirection="rtl" android:gravity="start|center_vertical"
        android:maxLines="2" android:ellipsize="end" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="פותחים את האפליקציה פעם אחת כדי להתחיל" />
    <TextView android:id="@+id/w_ask" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#7D708A" android:textSize="12sp" android:textDirection="rtl" android:gravity="start" android:text="איך אתה מרגיש?" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layoutDirection="ltr" android:paddingTop="4dp">
        <TextView android:id="@+id/w_m4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:layout_margin="2dp" android:gravity="center" android:textSize="20sp" android:background="@drawable/mood_off" android:text="😄" />
        <TextView android:id="@+id/w_m3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:layout_margin="2dp" android:gravity="center" android:textSize="20sp" android:background="@drawable/mood_off" android:text="😊" />
        <TextView android:id="@+id/w_m2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:layout_margin="2dp" android:gravity="center" android:textSize="20sp" android:background="@drawable/mood_off" android:text="🙂" />
        <TextView android:id="@+id/w_m1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:layout_margin="2dp" android:gravity="center" android:textSize="20sp" android:background="@drawable/mood_off" android:text="😕" />
        <TextView android:id="@+id/w_m0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:layout_margin="2dp" android:gravity="center" android:textSize="20sp" android:background="@drawable/mood_off" android:text="😔" />
    </LinearLayout>
</LinearLayout>
